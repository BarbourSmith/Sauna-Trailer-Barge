                                {
                                  "atomType": "Code",
                                  "x": 0.4901746724890829,
                                  "y": 0.7515151515151516,
                                  "uniqueID": "id-196902",
                                  "ioValues": [
                                    {
                                      "name": "Shape",
                                      "ioValue": "__GEOMETRY_INPUT__"
                                    },
                                    {
                                      "name": "Number",
                                      "ioValue": "__GEOMETRY_INPUT__"
                                    },
                                    {
                                      "name": "distX",
                                      "ioValue": "__GEOMETRY_INPUT__"
                                    },
